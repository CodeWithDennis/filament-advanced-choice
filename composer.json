{
    "name": "codewithdennis/filament-advanced-choice",
    "description": "Beautiful, customizable radio and checkbox form layouts for FilamentPHP.",
    "keywords": [
        "filament",
        "filamentphp",
        "filament-forms",
        "filament-plugin",
        "laravel",
        "livewire",
        "forms",
        "radio",
        "checkbox",
        "checkbox-list",
        "ui",
        "codewithdennis",
        "filament-advanced-choice"
    ],
    "homepage": "https://github.com/codewithdennis/filament-advanced-choice",
    "support": {
        "issues": "https://github.com/codewithdennis/filament-advanced-choice/issues",
        "source": "https://github.com/codewithdennis/filament-advanced-choice"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "CodeWithDennis",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/forms": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9||^8.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "CodeWithDennis\\FilamentAdvancedChoice\\": "src/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeWithDennis\\FilamentAdvancedChoice\\FilamentAdvancedChoiceServiceProvider"
            ],
            "aliases": {
                "FilamentAdvancedChoice": "CodeWithDennis\\FilamentAdvancedChoice\\Facades\\FilamentAdvancedChoice"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
